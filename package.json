{
  "name": "mental-ai",
  "version": "0.1.0",
  "private": true,
  "description": "MENTAL.AI - AI-assisted mental health screening research pipeline. Not a clinical diagnostic system.",
  "scripts": {
    "postinstall": "npm --prefix web install",
    "dev": "bash start-dev.sh",
    "dev:web": "npm --prefix web run dev",
    "dev:api": "bash -c 'PYTHONPATH=\"Step 12 - Packaging/package:.\" python3 -m uvicorn api.api:app --host 127.0.0.1 --port 8000 --reload'",
    "build": "npm --prefix web run build",
    "typecheck": "npm --prefix web run typecheck",
    "lint": "npm --prefix web run lint",
    "test": "PYTHONPATH=\"Step 12 - Packaging/package:.\" python3 -m pytest tests -q",
    "verify": "PYTHONPATH=\"Step 12 - Packaging/package:.\" python3 scripts/verify_project.py"
  }
}