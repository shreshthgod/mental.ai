# Environment variables for the MENTAL.AI screening service.
#
#   cp .env.example .env
#
# Loaded automatically on startup (python-dotenv). Real environment variables
# always take precedence, so container and CI configuration is never overridden
# by this file. Do NOT commit a real .env; it is already gitignored.

# Service configuration
HOST=0.0.0.0
PORT=8000
SERVICE_VERSION=0.1.0
LOG_LEVEL=INFO
RELOAD=false

# Artifact paths.
# Leave unset to use the packaged default resolved from the repository root.
# A relative value is resolved against the current working directory, so set an
# absolute path here if you launch the service from anywhere else.
# ARTIFACTS_DIR=Step 12 - Packaging/package/mental_health_screening/artifacts

# Runtime limits
# Honored. Must be an integer between 1000 and 100000, measured in characters
# (not bytes). An unparseable or out-of-range value falls back to 10000 with a
# warning rather than failing startup. See decision D-008.
MAX_TEXT_LENGTH=10000

# Urgency decision threshold. Honored. Must be a number in (0, 1]; an invalid
# value fails startup loudly rather than being silently ignored, because a
# threshold that is not the one you asked for is worse than no threshold.
# Unset uses the packaged value from artifacts/config.json (0.15).
# See decision D-008.
URGENCY_THRESHOLD=0.15

# ------------------------------------------------------------------
# Supabase (identity + database)
# ------------------------------------------------------------------
# Authentication lives in Supabase Auth and screening history lives in Supabase
# Postgres. Apply supabase/schema.sql once, then set the values below.
#
# The three BACKEND keys go in the api service's environment (and .env locally).
# The two VITE_ keys go in the web service's environment and web/.env.local.
#
# The split is the whole security model:
#   VITE_SUPABASE_PUBLISHABLE_KEY  public. It ships in the browser bundle and
#                                 relies on Row Level Security for protection.
#   SUPABASE_SECRET_KEY           SECRET. Server-side only. It bypasses RLS, so
#                                 it must never appear in any VITE_ variable,
#                                 in vercel.json, or in any frontend file.

# --- web service (public) ---
# Supabase project URL.
VITE_SUPABASE_URL=
# Publishable key, from Project Settings -> API.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- api service (private) ---
# Same project URL as VITE_SUPABASE_URL.
SUPABASE_URL=
# Secret / service_role key, from Project Settings -> API Keys.
SUPABASE_SECRET_KEY=
# Publishable key again: GoTrue requires it on every authentication request.
# It is public by design, but the backend needs its own copy.
SUPABASE_PUBLISHABLE_KEY=
# Per-request timeout for Supabase calls, seconds.
SUPABASE_TIMEOUT_SECONDS=10
# Optional Node @supabase/server configuration. The Python API continues to
# verify sessions through GoTrue get_user; merely setting this does not change
# authentication or make local JWKS verification active in Python.
# Use your same project's /auth/v1/.well-known/jwks.json endpoint.
SUPABASE_JWKS_URL=

# --- api service (optional overrides) ---
# Greet every account with one shared name. Unset: each account is greeted by its
# own Supabase name.
MENTAL_AI_AUTH_NAME=
# Reported to the browser so it can tell a fresh session from a stale one.
# Supabase decides the real expiry.
MENTAL_AI_SESSION_TTL=3600
# Local declaration in /auth/providers diagnostics only; this does not enable
# the provider remotely. The browser checks Supabase's public provider settings
# before redirecting. Configure Google's OAuth client in the Supabase dashboard.
MENTAL_AI_ENABLE_GOOGLE=true

# ------------------------------------------------------------------
# Browser origins
# ------------------------------------------------------------------
# Comma-separated origins allowed to call the API directly from a browser.
# Not needed for the default setup, where Vite proxies /api to the backend.
MENTAL_AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Prediction allowance: 30 requests per verified owner per 60 seconds.
# Local workers must share this local writable SQLite file. Separate hosts need
# a shared ingress limiter; this file is not a distributed service.
MENTAL_AI_LIMIT_STORE=/tmp/mental-ai-predict-limits.sqlite3
