# Environment variables for the mental-health screening service.
# Copy to .env and adjust as needed. Do NOT commit real secrets.

# Service configuration
HOST=0.0.0.0
PORT=8000
SERVICE_VERSION=0.1.0
LOG_LEVEL=INFO
RELOAD=false

# Artifact paths
ARTIFACTS_DIR=Step 12 - Packaging/package/mental_health_screening/artifacts

# Runtime limits
MAX_TEXT_LENGTH=10000

# Optional threshold override (default preserved from config.json: 0.15)
# URGENCY_THRESHOLD=0.15
