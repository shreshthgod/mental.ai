# Environment variables for the MENTAL.AI screening service.
#
#   cp .env.example .env
#
# Loaded automatically on startup (python-dotenv). Real environment variables
# always take precedence, so container and CI configuration is never overridden
# by this file. Do NOT commit a real .env; it is already gitignored.

# Service configuration
HOST=0.0.0.0
PORT=8000
SERVICE_VERSION=0.1.0
LOG_LEVEL=INFO
RELOAD=false

# Artifact paths.
# Leave unset to use the packaged default resolved from the repository root.
# A relative value is resolved against the current working directory, so set an
# absolute path here if you launch the service from anywhere else.
# ARTIFACTS_DIR=Step 12 - Packaging/package/mental_health_screening/artifacts

# Runtime limits
MAX_TEXT_LENGTH=10000

# Optional threshold override (default preserved from config.json: 0.15)
# URGENCY_THRESHOLD=0.15

# ------------------------------------------------------------------
# Authentication (required for POST /predict)
# ------------------------------------------------------------------
# The defaults below are the documented research demo account, so a fresh
# checkout runs with `npm run dev` and no configuration. Override ALL THREE
# before any shared or non-local deployment.
MENTAL_AI_AUTH_USER=admin
MENTAL_AI_AUTH_PASSWORD=password

# Display name used in the greeting ("Hello, <name>") and the account menu.
# Optional: when unset it is derived from the user id above, so "admin" greets
# as "Admin". Set it to whatever the account holder is actually called.
MENTAL_AI_AUTH_NAME=

# HMAC signing key for session tokens. If unset, an ephemeral key is generated
# at process start and every existing session is invalidated on restart.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MENTAL_AI_TOKEN_SECRET=

# Session lifetime in seconds (default 43200 = 12h, clamped to 300..604800).
MENTAL_AI_SESSION_TTL=43200

# Login throttling: 10 failed attempts per client IP within a 5 minute window,
# then HTTP 429 until the window rolls over. In-memory and per-process, so a
# restart clears it and multiple replicas each track their own counts.

# Comma-separated browser origins allowed to call the API directly.
# Not needed for the default setup, where Vite proxies /api to the backend.
MENTAL_AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
